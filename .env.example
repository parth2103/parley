DEEPGRAM_API_KEY=replace-with-your-deepgram-key
CARTESIA_API_KEY=replace-with-your-cartesia-key
# LLM provider: anthropic (default) or groq (ultra-low latency)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
# Defaults to claude-3-5-haiku-20241022 for low-latency voice; or set claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# If using LLM_PROVIDER=groq:
# GROQ_API_KEY=replace-with-your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile

CARTESIA_VOICE_ID=replace-with-a-voice-id-from-your-cartesia-console
TTS_PROVIDER=cartesia

# If Cartesia setup fails, select elevenlabs and fill these instead.
# ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key
# ELEVENLABS_VOICE_ID=replace-with-a-voice-id-from-your-elevenlabs-console
